#
# Ceph side of the atlas-native vs CephFS benchmark: the upstream release image (daemons and
# ceph-fuse are already in it) plus fio. Built by ceph-up.sh.
ARG BASE
FROM ${BASE}
RUN dnf install -y --setopt=install_weak_deps=False fio ceph-fuse \
    && dnf clean all \
    && rpm -q ceph-osd ceph-mon ceph-mgr ceph-mds ceph-fuse fio fuse3-libs
COPY --chmod=0755 ceph-entry.sh /usr/local/bin/ceph-entry.sh
ENTRYPOINT ["/usr/local/bin/ceph-entry.sh"]
