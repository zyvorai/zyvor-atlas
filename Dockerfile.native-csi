# atlas-native-csi: the CSI plugin for atlas-native filesystems (docs/NATIVE_CSI.md), plus the
# atlas-native-mount FUSE client the node plugin runs for every published volume. fuser mounts
# through fusermount3, so the runtime image needs the fuse3 package and no libfuse headers.
# ---- builder ----
FROM docker.io/library/rust:1.99-bookworm@sha256:114c7a4425406451c2866b6aafe69fe29b1b298832db1277d411ac73c82d04d6 AS builder
RUN apt-get update && apt-get install -y --no-install-recommends protobuf-compiler && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY . .
RUN cargo build --release --locked -p atlas-native-csi --bin atlas-native-csi \
    && cargo build --release --locked -p atlas-native-fuse --features fuse --bin atlas-native-mount

# ---- runtime ----
FROM docker.io/library/debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251 AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates fuse3 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /build/target/release/atlas-native-csi /usr/local/bin/atlas-native-csi
COPY --from=builder /build/target/release/atlas-native-mount /usr/local/bin/atlas-native-mount
ENTRYPOINT ["/usr/local/bin/atlas-native-csi"]
