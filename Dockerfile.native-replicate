# atlas-native-replicate: asynchronous filesystem replication between two native clusters
# (docs/NATIVE_REPLICATION.md). Talks to both clusters over their HTTP APIs: no FUSE, no privileges.
# ---- builder ----
FROM docker.io/library/rust:1.99-bookworm@sha256:48b7f435b8fc6378ce43b44f15e3a47fd8919b2825f835c39bd4bd3da50af5b8 AS builder
WORKDIR /build
COPY . .
RUN cargo build --release --locked -p atlas-native-fuse --bin atlas-native-replicate

# ---- runtime ----
FROM docker.io/library/debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3 AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 atlas-native-replicate
COPY --from=builder /build/target/release/atlas-native-replicate /usr/local/bin/atlas-native-replicate
USER atlas-native-replicate
ENTRYPOINT ["/usr/local/bin/atlas-native-replicate"]
