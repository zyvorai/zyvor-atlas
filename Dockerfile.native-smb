# atlas-native-smb: SMB gateway for atlas-native filesystems (docs/NATIVE_SMB.md). Samba's smbd
# serves FUSE mounts of each shared filesystem; atlas-native-smb mounts them, writes the Samba
# configuration, creates the users' accounts and supervises smbd. Samba runs as its own,
# unmodified process from Debian's packages (GPL-3.0); nothing in Atlas links it.
# ---- builder ----
FROM docker.io/library/rust:1.99-bookworm@sha256:59037199c44290f2befcdd58dcc540164763fc296950255aaefeef096a1866b0 AS builder
WORKDIR /build
COPY . .
RUN cargo build --release --locked -p atlas-native-fuse --features fuse \
    --bin atlas-native-mount --bin atlas-native-smb

# ---- runtime ----
FROM docker.io/library/debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587 AS runtime
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates fuse3 samba \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/samba/smb.conf
COPY --from=builder /build/target/release/atlas-native-mount /usr/local/bin/atlas-native-mount
COPY --from=builder /build/target/release/atlas-native-smb /usr/local/bin/atlas-native-smb
EXPOSE 445
ENTRYPOINT ["/usr/local/bin/atlas-native-smb"]
