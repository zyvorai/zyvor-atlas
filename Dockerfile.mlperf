# atlas-mlperf: MLPerf Storage (MLCommons) runner for atlas-native filesystems (docs/MLPERF.md).
# Mounts a filesystem with atlas-native-mount and runs the unmodified upstream `mlpstorage`
# benchmark on it. MLPerf Storage is a separate program (Apache-2.0); nothing in Atlas links it.
# ---- builder ----
FROM docker.io/library/rust:1.99-bookworm@sha256:9181b56c2a21ab1d5e73cffe04fc762426d30aa7fac3c91141dd033f49a7fc8b AS builder
WORKDIR /build
COPY . .
RUN cargo build --release --locked -p atlas-native-fuse --features fuse --bin atlas-native-mount

# ---- runtime ----
# MLPerf Storage documents Ubuntu 24.04 with Python 3.12 as its tested platform.
FROM docker.io/library/ubuntu:25.10 AS runtime
ARG DEBIAN_FRONTEND=noninteractive
# Branch or tag of github.com/mlcommons/storage. Pin a release tag for a reproducible image.
ARG MLPERF_REF=v3.0
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git fuse3 util-linux openssh-client libopenmpi-dev openmpi-common openmpi-bin \
    && rm -rf /var/lib/apt/lists/*
# uv creates the benchmark's virtualenv from its lockfile on first use.
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:/opt/storage:${PATH}"
RUN git clone https://github.com/mlcommons/storage.git /opt/storage \
    && cd /opt/storage && git checkout "$MLPERF_REF" \
    && mlpstorage --help >/dev/null
COPY --from=builder /build/target/release/atlas-native-mount /usr/local/bin/atlas-native-mount
COPY deploy/mlperf/mlperf-run.sh /usr/local/bin/mlperf-run
ENTRYPOINT ["/usr/local/bin/mlperf-run"]
